{
  "name": "squad-observer",
  "version": "0.1.0",
  "description": "Real-time agent observability for Squad - watches .squad/ and emits OTel telemetry to Aspire Dashboard",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "squad-observer": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.52.0",
    "@opentelemetry/sdk-trace-node": "^1.25.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.0",
    "@opentelemetry/resources": "^1.25.0",
    "@opentelemetry/semantic-conventions": "^1.25.0"
  },
  "devDependencies": {},
  "keywords": ["squad", "ai-agents", "observability", "opentelemetry", "aspire"],
  "author": "Squad Contributors",
  "license": "MIT"
}
